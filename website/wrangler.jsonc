{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "forgeai-website",
  "compatibility_date": "2026-10-20",
  // The Worker only proxies the GUI installers from GitHub releases (/download/*). Everything else is the Astro build.
  "main": "./worker/index.ts",
  // Builds dist/ before every deploy, so a CI that only runs `wrangler deploy` (Cloudflare Workers Builds) works without a separate build step.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/download/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  // forgeai.wutz.dev is a custom domain on the wutz.dev zone (Cloudflare manages the DNS record and certificate).
  "routes": [{ "pattern": "forgeai.wutz.dev", "custom_domain": true }],
  "observability": { "enabled": true },
  // Workers Builds runs `wrangler preview` for non-production branches (pull requests), which requires this block. Assets and settings stay at the top level.
  "previews": {},
}

---
import Base from '../layouts/Base.astro';
import { localeBase, messages } from '../i18n/messages';

// Shown for any unknown path, so it has no locale of its own: both languages are listed.
const en = messages.en.notFound;
const zh = messages.zh.notFound;
---

<Base lang="en" title={messages.en.notFoundTitle} description={messages.en.notFoundDescription}>
  <main class="section not-found">
    <div class="container">
      <span class="eyebrow-text">404</span>
      <h1>{en.title}</h1>
      <p class="not-found-body">
        {en.body} <a href={localeBase.en}>{en.home}</a>, {en.or} <a href="https://github.com/wutz/forgeai#readme" rel="noopener">{en.docs}</a>{en.end}
      </p>
    </div>
    <div class="container">
      <span class="eyebrow-text" lang="zh-CN">{zh.eyebrow}</span>
      <h2 lang="zh-CN" class="not-found-zh">{zh.title}</h2>
      <p class="not-found-body" lang="zh-CN">
        {zh.body} <a href={localeBase.zh}>{zh.home}</a>{zh.or}<a href="https://github.com/wutz/forgeai#readme" rel="noopener">{zh.docs}</a>{zh.end}
      </p>
    </div>
  </main>
</Base>

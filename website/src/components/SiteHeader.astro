---
import { localeBase, messages, type Locale } from '../i18n/messages';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = messages[lang].header;
const base = localeBase[lang];
const other: Locale = lang === 'en' ? 'zh' : 'en';
---

<header class="site-header">
  <nav class="container nav" aria-label={t.mainNav}>
    <a class="brand" href={base} aria-label={t.home}>
      <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
        <defs>
          <linearGradient id="brand-tile" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#6366f1" />
            <stop offset="1" stop-color="#7c3aed" />
          </linearGradient>
        </defs>
        <rect width="32" height="32" rx="7" fill="url(#brand-tile)" />
        <g fill="#fff" transform="translate(5.1 6.1) scale(0.68)">
          <path d="M3 10 10 9h18v5h-5l-3 4v3l4 3v2H8v-2l4-3v-3l-2-3-3-1.5z" />
          <path d="m22 1 .9 2.3 2.3.9-2.3.9L22 7.4l-.9-2.3-2.3-.9 2.3-.9z" />
        </g>
      </svg>
      <span>forgeai</span>
    </a>
    <div class="nav-end">
      <div class="nav-links">
        <a href={`${base}#features`}>{t.features}</a>
        <a href={`${base}#how-it-works`}>{t.how}</a>
        <a href={`${base}#get-started`}>{t.start}</a>
        <a href="https://github.com/wutz/forgeai" rel="noopener">{t.github}</a>
      </div>
      <div class="controls">
        <div class="segmented" role="group" aria-label={t.theme}>
          <button type="button" data-theme-option="system" aria-pressed="true">{t.themeSystem}</button>
          <button type="button" data-theme-option="light" aria-pressed="false">{t.themeLight}</button>
          <button type="button" data-theme-option="dark" aria-pressed="false">{t.themeDark}</button>
        </div>
        <a
          class="lang-switch"
          href={localeBase[other]}
          hreflang={other === 'zh' ? 'zh-CN' : 'en'}
          lang={other === 'zh' ? 'zh-CN' : 'en'}
          data-lang-option={other}
        >{t.switchTo}</a>
      </div>
    </div>
  </nav>
</header>
